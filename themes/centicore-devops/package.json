{
  "name": "slidev-theme-centicore-devops",
  "version": "1.0.0",
  "description": "T1 Lampa corporate theme for Slidev",
  "type": "module",
  "keywords": [
    "slidev-theme",
    "slidev"
  ],
  "engines": {
    "node": ">=20.12.0",
    "slidev": ">=0.52.0"
  },
  "scripts": {
    "dev": "slidev example.md --port 3031",
    "build": "slidev build example.md",
    "export": "slidev export example.md",
    "screenshot": "slidev export example.md --format png"
  },
  "dependencies": {
    "@slidev/types": "^52.19.0"
  },
  "devDependencies": {
    "@slidev/cli": "^52.19.0"
  },
  "slidev": {
    "colorSchema": "light",
    "defaults": {
      "fonts": {
        "sans": "Arial, Helvetica, sans-serif",
        "mono": "'Courier New', Courier, monospace"
      }
    }
  }
}
