{
  "name": "centicore-devops-slides",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "slidev documents/slides.md --bind 0.0.0.0",
    "build": "slidev build documents/slides.md",
    "build:pages": "slidev build documents/slides.md --base / --without-notes",
    "preview": "vite preview --outDir documents/dist",
    "export": "slidev export documents/slides.md --output documents/export.pdf"
  },
  "dependencies": {
    "@slidev/cli": "^52.14.1",
    "@slidev/theme-default": "^0.25.0",
    "flint-chart": "^1.0.1",
    "vega": "^6.4.0",
    "vega-embed": "^7.3.0",
    "vega-lite": "^6.5.0"
  },
  "devDependencies": {
    "@iconify-json/mdi": "^1.2.3",
    "@playwright/test": "^1.59.1",
    "playwright-chromium": "^1.59.1",
    "pngjs": "^7.0.0",
    "vite": "^8.2.2"
  }
}
